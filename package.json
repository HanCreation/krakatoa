{
  "name": "krakatoa",
  "version": "1.0.0",
  "description": "An interactive 3D field guide to Krakatau and the Sunda Strait",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write app components lib tests README.md package.json tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HanCreation/krakatoa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/HanCreation/krakatoa/issues"
  },
  "homepage": "https://github.com/HanCreation/krakatoa#readme",
  "dependencies": {
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  }
